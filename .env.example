# Variáveis lidas pelo docker compose (interpolação ${VAR:-default}).
# Copie para `.env` (ignorado pelo git) e ajuste. Os valores abaixo são os mesmos
# defaults embutidos nos docker-compose*.yaml, então copiar sem editar não muda nada
# (exceto as chaves JWT: rode `pnpm jwt:keys`, que cria o `.env` e gera o par).
# Só o compose lê este arquivo: os apps recebem as variáveis pelo `environment:` de cada serviço.

# PostgreSQL (write store)
POSTGRES_USER=stubb
POSTGRES_PASSWORD=stubb
POSTGRES_DB=stubb

# MongoDB (read store): nome do banco usado pelo read-service e pelo projector
MONGO_DB=stubb_read

# Chaves JWT (Ed25519, PEM em base64, numa linha). Únicas variáveis sem default:
# um par fixo versionado seria reutilizado por qualquer clone. Preencha com `pnpm jwt:keys`
# (`--force` regera). O compose falha com instrução se estiverem vazias.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Cookie do refresh token: `false` em dev (http). Em produção com HTTPS, `true`.
COOKIE_SECURE=false

# E-mail (Mailpit em dev: SMTP só na rede interna; UI/API em MAILPIT_HOST_PORT)
SMTP_URL=smtp://mailpit:1025
MAIL_FROM="Stubb <nao-responda@stubb.local>"

# URL pública do web, usada nos links dos e-mails. Precisa acompanhar GATEWAY_HOST_PORT.
PUBLIC_WEB_URL=http://127.0.0.1:8080

# Seed da Identity (idempotente): cria o admin e o produtor de demonstração no boot.
# As variáveis E2E_* (E2E_ADMIN_*, E2E_ORGANIZER_*, E2E_MAILPIT_URL) NÃO são lidas daqui:
# se as credenciais do seed ou MAILPIT_HOST_PORT mudarem, exporte as E2E_* correspondentes
# no shell antes do `pnpm test:e2e`.
IDENTITY_SEED_ENABLED=true

# O admin é você: troque e-mail e senha no `.env`.
IDENTITY_ADMIN_ID=0193a4f0-0000-7000-8000-000000000000
IDENTITY_ADMIN_EMAIL=admin@stubb.local
IDENTITY_ADMIN_PASSWORD=stubb-admin-dev
IDENTITY_ADMIN_NAME="Administrador Stubb"
IDENTITY_ADMIN_CPF=12345678909

# O ID do produtor não deve mudar: os dados de demonstração do Catalog pertencem a ele.
IDENTITY_SEED_ORGANIZER_ID=0193a4f0-0000-7000-8000-000000000001
IDENTITY_SEED_ORGANIZER_EMAIL=produtor@stubb.local
IDENTITY_SEED_ORGANIZER_PASSWORD=stubb-produtor-dev
IDENTITY_SEED_ORGANIZER_NAME="Produtor Demo"
IDENTITY_SEED_ORGANIZER_CPF=98765432100
IDENTITY_SEED_ORGANIZER_ORGANIZATION="Produtora Demo"
IDENTITY_SEED_ORGANIZER_CNPJ=11222333000181

# Portas publicadas no host. Se um container não subir por porta, confira
# `netsh interface ipv4 show excludedportrange protocol=tcp` (faixas reservadas pelo Windows/WSL).
# A porta do Kafka (9094) não entra aqui: está atrelada ao advertised listener.
GATEWAY_HOST_PORT=8080
POSTGRES_HOST_PORT=5433
MONGO_HOST_PORT=27017
CONNECT_HOST_PORT=8083
KAFBAT_HOST_PORT=8081
MAILPIT_HOST_PORT=8025
