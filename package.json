{
  "name": "stubb",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm --filter @stubb/contracts build && eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm --filter @stubb/contracts build && pnpm -r typecheck",
    "test": "pnpm --filter @stubb/contracts build && pnpm -r test",
    "test:e2e": "pnpm --filter @stubb/e2e test:e2e && pnpm --filter @stubb/web test:e2e",
    "replay": "pnpm --filter @stubb/e2e replay",
    "seed:catalog": "pnpm --filter @stubb/contracts build && pnpm --filter @stubb/e2e seed:catalog",
    "jwt:keys": "node infra/scripts/generate-jwt-keys.mjs",
    "stack:up": "docker compose -f docker-compose.yaml up -d --build --wait",
    "stack:dev": "docker compose up --build --watch",
    "stack:down": "docker compose rm -fsv && docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
