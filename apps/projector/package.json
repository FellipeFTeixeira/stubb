    "@stubb/contracts": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "unplugin-swc": "2.0.0",
    "@swc/core": "1.16.20",
    "@types/node": "24.19.2",
    "@types/express": "5.0.6",
